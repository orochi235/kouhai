{
  "name": "dixeram",
  "version": "0.2.1",
  "private": true,
  "description": "An inbox for the questions you ask Claude Code mid-task, and their answers",
  "type": "module",
  "bin": {
    "dixeram": "bin/dixeram"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite ui",
    "build": "vite build ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "lint": "biome check .",
    "service:install": "scripts/install-service.sh",
    "service:uninstall": "scripts/uninstall-service.sh",
    "menubar:install": "${PERCH:-perch} install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
