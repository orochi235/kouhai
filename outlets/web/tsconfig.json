{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["../../src/engine/*"],
      "@weasel-js/ui/components/*": ["../../../weasel/packages/ui/dist/components/*/index.d.ts"],
      "@weasel-js/prefs/react": ["../../../weasel/packages/prefs/dist/react.d.ts"],
      "@weasel-js/icons/react": ["../../../weasel/packages/icons/dist/react.d.ts"],
      "@weasel-js/*": ["../../../weasel/packages/*/dist/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "weasel.ts"]
}
